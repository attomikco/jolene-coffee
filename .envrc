# Pins Shopify CLI commands to the Jolene Coffee store, for THIS directory only.
# Without a pin, a bare `shopify theme dev` falls back to the CLI's global
# last-used-store cache — that is how a stray dev theme once landed on c010f3-c8.
# Scoped via direnv so sibling client repos (gameplan-skincare, la-monjita, ...)
# are unaffected and get no implicit default.
#
# Requires direnv (`brew install direnv`) and a one-time `direnv allow` per clone.
# An explicit --store or -e flag still overrides this.
export SHOPIFY_FLAG_STORE=yf0y9j-hu.myshopify.com
