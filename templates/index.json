enter items-center"}},"testimonial_Net3Mq":{"type":"testimonial","settings":{"content":"\"The oat milk latte hits different — creamy but not heavy, exactly what I needed.\"","name":"<p>Jordan M.</p>","title":"","logo_height":80,"layout_x_alignment":"text-center justify-center items-center"}},"testimonial_nAKf8z":{"type":"testimonial","settings":{"content":"\"Finally found a cold brew that doesn't give me the jitters but still wakes me up.\"","name":"<p>Taylor B.</p>","title":"","logo_height":80,"layout_x_alignment":"text-center justify-center items-center"}},"testimonial_7XQnba":{"type":"testimonial","settings":{"content":"Bring these to every studio session now — the taste and energy are unmatched.","name":"<p>Cameron D.</p>","title":"","logo_height":80,"layout_x_alignment":"text-center justify-center items-center"}},"testimonial_eCjygz":{"type":"testimonial","settings":{"content":"Worth the price for sure. Single-origin beans make all the difference in flavor.","name":"<p>River S.</p>","title":"","logo_height":60,"layout_x_alignment":"text-center justify-center items-center"}}},"block_order":["testimonial_qW4RjP","testimonial_Net3Mq","testimonial_nAKf8z","testimonial_7XQnba","testimonial_eCjygz"],"settings":{"announcement_delay":3,"spacing_top":100,"spacing_bottom":50,"color_scheme":"color__bg-shade-2","color_background":"#ffffff","color_text":"","color_border":"color__border-divider-1","enable_color_fade":false,"style_border":"","layout_y_alignment":"items-center","layout_x_alignment":"justify-center","layout_column_width":100,"enable_margin":true,"visibility":""}},"content_grid_DwtYHh":{"type":"content-grid","blocks":{"content_jUcABU":{"type":"content","settings":{"heading":"","content":"","button_label":"","url":"","image":"shopify://shop_images/JoleneCoffee_400a5cba-f85c-4b06-8c2a-10ba28f5901b.png","show_image_as_background":true,"enable_autoplay":true,"enable_mute_toggle":true,"enable_loop":true,"spacing_minimum_height":400,"enable_padding":true,"color_scheme":"color__bg-body color__text","color_border":"outline--width color__outline-divider-1","color_text":"color__text","color_button":"btn--small btn--plain","enable_gradient":false,"text_position":"below","layout_y_alignment":"justify-end","layout_x_alignment":"left","layout_row_span":"row-span-1","layout_col_span":"col-span-1 md:col-span-2"}},"content_6EQNYk":{"type":"content","settings":{"heading":"Never Run Out Again","content":"<p>Subscribe and save 10% on every delivery. Your coffee shows up when you need it, exactly how you like it. <br/><br/>✓ Skip or cancel anytime <br/>✓ Member-only access to limited drops<br/></p>","button_label":"Subscribe Now","url":"shopify://collections/all","show_image_as_background":false,"enable_autoplay":true,"enable_mute_toggle":true,"enable_loop":true,"spacing_minimum_height":250,"enable_padding":true,"color_scheme":"color__bg-primary color__primary","color_border":"outline--width color__outline-divider-1","color_text":"color__text","color_button":"btn--small btn--secondary","enable_gradient":false,"text_position":"below","layout_y_alignment":"justify-center","layout_x_alignment":"left","layout_row_span":"row-span-1","layout_col_span":"col-span-1 md:col-span-2"}}},"block_order":["content_jUcABU","content_6EQNYk"],"settings":{"heading":"","content":"","button_label":"","button_url":"","spacing_top":110,"spacing_bottom":110,"color_scheme":"color__bg-body","color_background":"#ffffff","color_text":"","color_border":"color__border-divider-1","color_button":"btn btn--secondary","enable_color_fade":false,"style_border":"","layout_row_desktop":4,"layout_row_mobile":1,"layout_x_alignment":"justify-between","enable_margin":true,"enable_split":false,"enable_split_heading":false,"visibility":"hidden md:block"}},"accordions_LrLbTK":{"type":"accordions","blocks":{"content_KjJnfW":{"type":"content","settings":{"heading":"What makes Jolene Coffee different from other cold brews?","content":"<p>Honestly? Taste it and you'll know. But if you need the details: 24-hour slow brew, premium single-origin beans, filtered water, nothing artificial, no concentrates. We kept it simple because the coffee didn't need anything else.</p>","icon":"","color_scheme":"btn","enable_open":true}},"content_Kqy98Q":{"type":"content","settings":{"heading":"How much caffeine is in each can?","content":"<p>Black (Cold Brew) packs 236mg per 8 fl oz can. The Oat Milk Lattes come in at 118mg. Pick your speed.</p>","icon":"","color_scheme":"btn","enable_open":false}},"content_3jkmy8":{"type":"content","settings":{"heading":"Are your coffee beans Fair Trade certified?","content":"<p>Always. Fair Trade and Non-GMO certified, sourced from Café Femenino, a women-led collective in Peru. Who grows your coffee matters. We made sure ours were the best.</p>","icon":"","color_scheme":"btn","enable_open":false}},"content_ngLB3x":{"type":"content","settings":{"heading":"Do I need to refrigerate Jolene Coffee?","content":"<p>Best served cold. Shelf-stable until opened. Once you crack one, finish it within 24 hours. You weren't going to save half anyway.</p>","icon":"","color_scheme":"btn","enable_open":false}},"content_9WdCEU":{"type":"content","settings":{"heading":"Is the Oat Milk Latte gluten-free?","content":"<p>All of it. Gluten-free, dairy-free, Non-GMO. We wanted the White to be smooth enough that you'd never know what's missing. Because nothing is.</p>","icon":"","color_scheme":"btn","enable_open":false}},"content_GDRarW":{"type":"content","settings":{"heading":"What pack sizes do you offer?","content":"<p>Depends on the flavor — Black and White start at 4 cans, the new Oat Milk Lattes at 12. If you're new here, start with a Variety Pack: Classic pairs Black and White, Latte covers hazelnut, red velvet and salted caramel.</p>","icon":"","color_scheme":"btn","enable_open":false}}},"block_order":["content_KjJnfW","content_Kqy98Q","content_3jkmy8","content_ngLB3x","content_9WdCEU","content_GDRarW"],"settings":{"heading":"you asked, we answered","