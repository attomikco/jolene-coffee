<!-- snippets/product__variant-cards-grid.liquid -->
{% comment %}
  Inner sub-snippet: renders ONE option's value list as a card grid.
  Called by product__variant-cards.liquid once per option (or once
  total for the single-option soft-override path).

  Accepts:
  - block: {object}
  - section: {object}
  - product: {object}
  - card_option: {object} The option (one entry from product.options_with_values)
  - is_first_option: {boolean} True only for the first rendered option;
      controls whether x-init's "popular" pre-selection runs (we only
      want the auto-pop on the first option, not every option).
  - has_config: {boolean} Whether vc_config_raw is non-blank.
  - vc_config_raw: {array} The parsed per-value metafield array.
  - hide_option_label: {boolean} Suppress this option's "Pack: 12 Cans" heading
      when the caller renders its own (the PDP buy box supplies a
      "STEP 1 - HOW MANY" label in its place).
{% endcomment %}

{%- comment -%}
  A NOTE ON THE FONT SIZES BELOW

  name_font_size, price_font_size and savings_font_size are still in this
  block's schema, but the tile figures no longer read them. They were fixed px
  values stored in templates/product.json, so they sat on their own ladder and
  stopped agreeing with the rest of the site the moment settings.type_base_size
  moved — which is the whole reason the buy box was put on the type scale.

  badge_font_size is the one left as-is: the badge is 9px and the semantic
  scale bottoms out around 13px, so there is no token that small to move it to.
{%- endcomment -%}
{%- liquid
  assign card_option_position = card_option.position
  assign option_index = card_option_position | minus: 1

  assign variant_count = card_option.values | size
  assign popular_index = variant_count | minus: 1 | divided_by: 2
  assign last_index = variant_count | minus: 1

  assign popular_value = card_option.values[popular_index]
  assign popular_encoded = popular_value | replace: ' ', '+' | base64_encode

  assign popular_variant = nil
  for v in product.variants
    assign v_opt_encoded = v.options[option_index] | replace: ' ', '+' | base64_encode
    if v_opt_encoded == popular_encoded
      assign popular_variant = v
      break
    endif
  endfor

  # === PER-UNIT BASELINE ===
  # Pack size comes from the leading integer of the option value label
  # ("24 Cans" -> 24) — the same idiom product-checklist.liquid uses on variant
  # titles for its value-prop line. `plus: 0` makes a non-numeric label
  # ("Small") resolve to 0, which switches off every per-unit figure below
  # instead of dividing by zero.
  #
  # The baseline is the SMALLEST pack on this option, so "save N%" compares
  # per-unit rates rather than pack totals. Derived from live variant prices —
  # nothing here is hardcoded, and a price change re-derives it on next render.
  assign base_pack_size = 0
  assign base_per_unit = 0
  for bv in card_option.values
    assign bv_pack = bv | split: ' ' | first | plus: 0
    if bv_pack > 0
      assign bv_is_smaller = false
      if base_pack_size == 0
        assign bv_is_smaller = true
      elsif bv_pack < base_pack_size
        assign bv_is_smaller = true
      endif
      if bv_is_smaller
        assign bv_encoded = bv | replace: ' ', '+' | base64_encode
        for v in product.variants
          assign v_opt_encoded = v.options[option_index] | replace: ' ', '+' | base64_encode
          if v_opt_encoded == bv_encoded
            assign base_pack_size = bv_pack
            assign base_per_unit = v.price | divided_by: bv_pack
            break
          endif
        endfor
      endif
    endif
  endfor
-%}

{% comment %}
  Option label — sits above this option's card grid.

  Suppressed when the caller supplies its own heading. The PDP buy box puts a
  "STEP 1 · HOW MANY" label here instead, and "Pack: 12 Cans" directly beneath
  it restates what the selected tile already shows.
{% endcomment %}
{% unless hide_option_label %}
  <div class="mb-3 mt-6 flex justify-between">
    <label class="type--small font-bold">
      {{ card_option.name }}
      {% for value in card_option.values %}
        <span
          class="font-normal"
          :class="{
            'inline': option{{ card_option_position }} == `{{ value | replace: ' ', '+' | base64_encode }}`,
            'hidden': option{{ card_option_position }} != `{{ value | replace: ' ', '+' | base64_encode }}`
          }"
          x-cloak
        >: {{ value -}}</span>
      {% endfor %}
    </label>
  </div>
{% endunless %}

<div
  class="ac-vc-grid ac-vc-grid--{{ section.id }}"
  style="align-items:stretch;"
  {% if is_first_option and popular_variant and variant_count > 2 %}
    x-init="
      $nextTick(() => {
        option{{ card_option_position }} = `{{ popular_encoded }}`;
        handleProductFormChange(null, '{{ section.id }}', '{{ product.handle | handle }}', '{{ card_option_position }}', '{{ popular_value.id }}');
      });
    "
  {% endif %}
>
  {% for value in card_option.values %}
    {%- liquid
      assign value_encoded = value | replace: ' ', '+' | base64_encode

      # Find a representative variant for THIS card. Same single-option
      # approximation themes like Dawn/Sense use: the first variant whose
      # Nth option matches THIS value. The actual cart variant gets
      # resolved by handleProductFormChange on click which combines
      # option1+option2+option3.
      assign card_variant = nil
      for v in product.variants
        assign v_opt_encoded = v.options[option_index] | replace: ' ', '+' | base64_encode
        if v_opt_encoded == value_encoded
          assign card_variant = v
          break
        endif
      endfor

      assign option_available = false
      for v in product.variants
        if v.available
          assign v_opt_encoded = v.options[option_index] | replace: ' ', '+' | base64_encode
          if v_opt_encoded == value_encoded
            assign option_available = true
            break
          endif
        endif
      endfor

      assign val_config = nil
      if has_config
        assign val_str = value | strip
        for cfg in vc_config_raw
          if cfg.value == val_str
            assign val_config = cfg
            break
          endif
        endfor
        if val_config == nil
          assign val_handle = value | handleize
          for cfg in vc_config_raw
            assign cfg_handle = cfg.value | handleize
            if cfg_handle == val_handle
              assign val_config = cfg
              break
            endif
          endfor
        endif
      endif

      # === BADGE ===
      # Precedence (highest to lowest):
      #   1. Ships Free (card_variant.price >= settings.pdp_free_shipping_threshold)
      #        → ships_free_color_scheme. Wins outright — replaces Popular/Best
      #        Value on that tile, per the schema's own "Ships Free wins when
      #        triggered" note.
      #   2. Per-product metafield (val_config.badge):
      #        - badge_color == 'secondary' → popular_color_scheme
      #        - else → best_value_color_scheme
      #   3. Auto-heuristic by position:
      #        - middle index, not first/last → "Most Popular" + popular_color_scheme
      #
      # Ships Free is SSR'd off the ONE-TIME price (the buy box's default
      # selection — jc_plan_id starts at 0). Unlike the static value-prop line
      # in product-checklist.liquid, this tile already lives inside the buy
      # box's Alpine x-data, so instead of suppressing the badge outright on
      # any subscribable product, it stays wired live: jcTileShipsFree() in
      # jc-buybox-state.liquid re-checks the plan-effective price and hides
      # the badge (x-show below) if a subscription discount drops this tile
      # under the threshold. A discount only ever moves price down, so this
      # SSR pass can only ever need to hide, never add, a badge.
      #
      # "Best Value" is otherwise gone. The hero savings sentence states the
      # saving in dollars against the smallest pack, which is the same claim
      # with a number attached — and two competing superlatives in one row
      # read as noise. "Most Popular" is the other badge left in the row.
      assign fs_threshold = settings.pdp_free_shipping_threshold | times: 100
      assign ships_free = false
      if fs_threshold > 0 and option_available and card_variant and card_variant.price >= fs_threshold
        assign ships_free = true
      endif

      assign badge_text = ''
      assign badge_scheme = ''
      if ships_free
        assign badge_text = 'Ships Free'
        assign badge_scheme = block.settings.ships_free_color_scheme
      elsif val_config and val_config.badge != blank
        assign badge_text = val_config.badge
        if val_config.badge_color == 'secondary'
          assign badge_scheme = block.settings.popular_color_scheme
        else
          assign badge_scheme = block.settings.best_value_color_scheme
        endif
      elsif option_available
        if forloop.index0 == popular_index and forloop.index0 != 0 and forloop.index0 != last_index
          assign badge_text = 'Most Popular'
          assign badge_scheme = block.settings.popular_color_scheme
        endif
      endif

      # The theme's color scheme classes (color__bg-X / color__X) are also
      # applied to the parent card via Alpine :class. The card's classes
      # have a descendant rule (.color__primary *, .color__tertiary *) that
      # propagates `color` (text color) to ALL descendants — including this
      # badge. That descendant rule ties the badge's own color class on
      # specificity, so the badge text inherits the card's foreground color
      # regardless of badge_scheme.
      #
      # Background has NO equivalent descendant rule (background isn't
      # inherited and there's no .color__bg-X * selector), so the bg class
      # works fine without `!important`.
      #
      # Asymmetric prefix:
      #   - bg classes (color__bg-X): keep unprefixed — they exist as-is
      #     and don't need to win against anything.
      #   - text-color classes (color__X): prepend `!` to use the theme's
      #     existing `!`-prefixed `!important` variants. Beats the parent's
      #     descendant rule via !important regardless of source order.
      #
      # Verified default scheme outputs:
      #   popular_color_scheme:    "color__bg-secondary !color__secondary"
      #   best_value_color_scheme: "color__bg-primary !color__primary"
      #   ships_free_color_scheme: "color__bg-shade-1 !color__text"
      assign badge_scheme_strong = ''
      if badge_scheme != blank
        assign bs_parts = badge_scheme | split: ' '
        for c in bs_parts
          if c != blank
            if c contains 'color__bg-'
              assign badge_scheme_strong = badge_scheme_strong | append: ' ' | append: c
            else
              assign badge_scheme_strong = badge_scheme_strong | append: ' !' | append: c
            endif
          endif
        endfor
        assign badge_scheme_strong = badge_scheme_strong | strip
      endif

      # === PER-UNIT PRICE ===
      # Divided in cents so it always rounds down — $35.99 / 12 = $2.99, never
      # a rounded-up $3.00 we don't actually charge. Falls back to the metafield
      # label when a per-value config supplies one.
      #
      # `per_unit_is_live` marks the computed case. Those figures get bound to
      # the plan-aware getters so that selecting a subscription repaints them
      # along with the hero price; a label supplied verbatim by the per-value
      # metafield is left exactly as the merchant wrote it.
      assign pack_size = value | split: ' ' | first | plus: 0
      assign per_unit_label = ''
      assign per_unit_is_live = false
      if val_config and val_config.per_unit_label != blank
        assign per_unit_label = val_config.per_unit_label
      elsif card_variant and pack_size > 0
        assign per_unit_cents = card_variant.price | divided_by: pack_size
        assign per_unit_label = per_unit_cents | money | append: '/can'
        assign per_unit_is_live = true
      endif

      # === SHIPPING NOTE ===
      # Pack sizes that aren't a multiple of 12 (4, 8, 16, ...) ship on a
      # different timeline than the standard 12-packs. Flag it on the tile
      # itself rather than a separate line so the caveat travels with the
      # card that triggers it.
      assign shipping_note = ''
      if pack_size > 0
        assign pack_mod = pack_size | modulo: 12
        if pack_mod != 0
          assign shipping_note = 'Shipping for this qty or item will begin on August 27'
        endif
      endif

      # === SAVINGS ===
      # Against the smallest pack's per-unit rate, not compare-at: these packs
      # have no compare_at_price, and comparing pack totals would never show a
      # saving because a bigger pack always costs more in absolute terms.
      # Suppressed on the smallest pack itself (it is the baseline).
      assign savings_label = ''
      assign has_compare_at = false
      if card_variant and card_variant.compare_at_price and card_variant.compare_at_price > card_variant.price
        assign has_compare_at = true
      endif
      #
      # `savings_is_live` is true for every pack that CAN be compared, the
      # baseline included. The baseline's label stays blank — it has nothing to
      # save against — but the line is still rendered and bound, so all four
      # tiles carry the same number of rows and their content aligns instead of
      # the smallest pack floating a line short.
      assign savings_is_live = false
      if val_config and val_config.savings_label != blank
        assign savings_label = val_config.savings_label
      elsif card_variant and pack_size > 0 and base_per_unit > 0
        assign savings_is_live = true
        if pack_size != base_pack_size
          assign this_per_unit = card_variant.price | divided_by: pack_size
          if this_per_unit < base_per_unit
            assign per_unit_diff = base_per_unit | minus: this_per_unit
            assign savings_pct = per_unit_diff | times: 100 | divided_by: base_per_unit
            if savings_pct > 0
              assign savings_label = 'save ' | append: savings_pct | append: '%'
            endif
          endif
        endif
      endif

      # === FREE SHIPPING ===
      # The per-tile "Ships Free" badge is computed above (see === BADGE ===)
      # and only marks tiles that clear the threshold outright. The "$24
      # away" style earned-progress message is a cart-level fact about the
      # current selection, not a property of four tiles at once — that still
      # renders as a single progress bar under the whole row (see
      # jc-buybox-shipping.liquid), not repeated per tile.
    -%}

    <button
      type="button"
      class="ac-vc-card{% unless option_available %} ac-vc-card--unavailable{% endunless %}"
      style="
        border: {{ block.settings.card_border_width }}px solid currentColor;
        border-radius: {{ block.settings.card_border_radius }}px;
        padding: 12px 12px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
      "
      :class="option{{ card_option_position }} == `{{ value_encoded }}`
        ? '{{ block.settings.selected_color_scheme }}'
        : '{{ block.settings.color_scheme }}'"
      :style="option{{ card_option_position }} == `{{ value_encoded }}` ? { borderWidth: '2px' } : {}"
      data-option-value-id="{{ value.id }}"
      data-option-position="{{ card_option_position }}"
      data-variant-id="{% if card_variant %}{{ card_variant.id }}{% endif %}"
      data-value="{{ value_encoded }}"
      @click="
        option{{ card_option_position }} = `{{ value_encoded }}`;
        {% if value.product_url %}
          handleCombinedListing('{{ value.product_url }}', '{{ section.id }}');
        {% else %}
          handleProductFormChange(null, '{{ section.id }}', '{{ product.handle | handle }}', '{{ card_option_position }}', '{{ value.id }}');
        {% endif %}
      "
      :disabled="product_loading"
    >

      {% if badge_text != blank %}
        <span
          class="ac-vc-badge {{ badge_scheme_strong }}"
          style="
            font-size: {{ block.settings.badge_font_size }}px;
            border-radius: {{ block.settings.badge_border_radius }}px;
          "
          {% if ships_free and card_variant %}
            x-show="jcTileShipsFree({{ card_variant.id }})"
          {% endif %}
        >{{ badge_text }}</span>
      {% endif %}

      <div class="ac-vc-card__inner" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;">

        <div
          class="ac-vc-name"
          style="
            font-size: var(--type__font-small);
            font-weight: {{ block.settings.name_font_weight }};
            font-family: var(--type__font-header-family, sans-serif);
          "
        >{{ value }}</div>

        {% if option_available %}

          {% if card_variant %}
            <div style="display:flex;align-items:baseline;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:4px;">
              <span
                class="ac-vc-price"
                style="
                  font-size: var(--type__font-smaller);
                  font-family: var(--type__font-body-family, sans-serif);
                  font-weight: 700;
                "
                x-text="jcMoney(jcTilePrice({{ card_variant.id }}))"
              >{{ card_variant.price | money }}</span>
              {% if has_compare_at %}
                <span
                  class="ac-vc-compare"
                  style="
                    font-size: var(--type__font-100);
                    opacity: 0.45;
                    text-decoration: line-through;
                    font-family: var(--type__font-body-family, sans-serif);
                  "
                >{{ card_variant.compare_at_price | money }}</span>
              {% endif %}
            </div>

            {% comment %}
              Shopify's auto unit_price (e.g. "$4.50/item") shown when the
              variant carries unit-pricing data. Renders below the main
              price. Format mirrors Shopify's standard:
                "$35.99 - $4.50/item"
              Only renders when variant.unit_price is present — Shopify
              auto-omits for variants without unit pricing configured.
            {% endcomment %}
            {% if card_variant.unit_price %}
              <div
                class="ac-vc-unitprice"
                style="
                  font-size: var(--type__font-100);
                  font-family: var(--type__font-body-family, sans-serif);
                  opacity: 0.65;
                  margin-top: 2px;
                "
              >{{ card_variant.price | money }} - {{ card_variant.unit_price | money }}/{{ card_variant.unit_price_measurement.reference_unit }}</div>
            {% endif %}
          {% endif %}

          {% comment %}
            Per-unit rate and its percentage sit on separate rows, and the
            savings row is emitted even when it has nothing to say (a
            non-breaking space holds it open). Sharing one wrapped row made the
            smallest pack — the only one with no saving — a line shorter than
            its neighbours, so its price sat at a different height.
          {% endcomment %}
          {% if block.settings.show_per_unit and per_unit_label != blank %}
            <div
              class="ac-vc-perunit"
              style="
                font-size: var(--type__font-smaller);
                font-family: var(--type__font-body-family, sans-serif);
                margin-top: 2px;
              "
              {% if per_unit_is_live %}
                x-text="`${jcMoney(jcTileUnit({{ card_variant.id }}))}/can`"
              {% endif %}
            >{{ per_unit_label }}</div>
          {% endif %}

          {% if savings_is_live or savings_label != blank %}
            <div
              class="ac-vc-savings"
              style="
                font-size: var(--type__font-100);
                font-family: var(--type__font-body-family, sans-serif);
                font-weight: 700;
                margin-top: 2px;
              "
              {% if savings_is_live %}
                x-text="jcTileSavePct({{ card_variant.id }}) > 0 ? `save ${jcTileSavePct({{ card_variant.id }})}%` : '\u00A0'"
              {% endif %}
            >{% if savings_label != blank %}{{ savings_label }}{% else %}&nbsp;{% endif %}</div>
          {% endif %}

          {% if shipping_note != blank %}
            <div
              class="ac-vc-shipping-note"
              style="
                font-size: var(--type__font-100);
                font-family: var(--type__font-body-family, sans-serif);
                opacity: 0.65;
                margin-top: 4px;
              "
            >{{ shipping_note }}</div>
          {% endif %}

        {% else %}
          <div class="ac-vc-soldout">Sold Out</div>
        {% endif %}

      </div>
    </button>
  {% endfor %}
</div>
