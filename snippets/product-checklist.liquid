<!-- snippets/product-checklist.liquid -->
{% comment %}
  Product checklist using theme-native patterns.

  Accepts:
  - block: {object} The block object with settings.

  Usage:
    {% render 'product-checklist', block: block %}
{% endcomment %}

{%- liquid
  # Bullets are per-product: the custom.pdp_highlights list metafield wins. When it is
  # empty we fall back to the block's item_1–item_5 settings, collapsed into the same
  # array shape so the markup below has a single rendering path.
  assign highlights = product.metafields.custom.pdp_highlights.value

  if highlights == blank
    assign fallback = ''
    assign item_keys = 'item_1,item_2,item_3,item_4,item_5' | split: ','
    for item_key in item_keys
      assign item = block.settings[item_key]
      if item != blank
        assign fallback = fallback | append: item | append: '~|~'
      endif
    endfor
    assign highlights = fallback | split: '~|~'
  endif
-%}

<div
  class="w-full px-4 {{ block.settings.color_scheme }}"
  style="
    padding-top:{{ block.settings.spacing_top }}px;
    padding-bottom:{{ block.settings.spacing_bottom }}px;
  "
  {{ block.shopify_attributes }}
>
  <ul class="ac-checklist">
    {% for item in highlights %}
      <li class="ac-checklist__item">
        <span class="ac-checklist__check {{ block.settings.check_color_scheme }}">
          <svg viewBox="0 0 24 24"><path d="M20 6L9 17L4 12" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="ac-checklist__text">{{ item }}</span>
      </li>
    {% endfor %}

    {%- liquid
      # Build the value-prop line from live variant pricing rather than hardcoding it.
      # Matches the variant whose title starts with value_prop_pack_size (e.g. "24 Cans"),
      # divides in cents so the per-unit figure always rounds down, and appends
      # "Ships Free" only when that variant actually clears the shipping threshold.
      assign vp_text = block.settings.value_prop_text
      assign vp_size = block.settings.value_prop_pack_size | plus: 0

      if vp_size > 0
        assign vp_variant = nil
        for v in product.variants
          assign v_size = v.title | split: ' ' | first | plus: 0
          if v_size == vp_size
            assign vp_variant = v
            break
          endif
        endfor

        if vp_variant
          assign vp_unit = vp_variant.price | divided_by: vp_size | money
          assign vp_text = vp_size | append: ' cans, ' | append: vp_unit | append: ' each'

          # "Ships Free" is claimed off the ONE-TIME price, because that is the only
          # price this line can see: it is server-rendered Liquid and the shopper's
          # purchase option is a client-side choice made after the page is built.
          # On a subscribable product the claim is therefore unsafe — a subscription
          # discount can drop the same pack under the threshold (the 24-can lands at
          # $59.39 against a $60 threshold) and the line would promise free shipping
          # the buy box, correctly, refuses to. So it is suppressed wherever a
          # selling plan exists at all, rather than guessed at.
          #
          # The pack size and per-can figure are unaffected: those are true of the
          # variant whatever plan is picked. The free-shipping question is answered
          # live, and for the actual selection, by the progress bar under the size
          # tiles (jc-buybox-shipping.liquid).
          assign vp_threshold = settings.pdp_free_shipping_threshold | times: 100
          if vp_threshold > 0 and vp_variant.price >= vp_threshold and product.selling_plan_groups.size == 0
            assign vp_text = vp_text | append: ' + Ships Free'
          endif
        endif
      endif
    -%}

    {% if vp_text != blank %}
      <li
        class="ac-checklist__value-prop {{ block.settings.badge_color_scheme }}"
        style="
          border: {{ block.settings.value_border_width | default: 1 }}px solid currentColor;
          border-radius: {{ block.settings.value_border_radius | default: 8 }}px;
        "
      >
        {% unless block.settings.value_prop_tag == blank %}
          <span class="ac-checklist__value-tag {{ block.settings.tag_color_scheme }}">{{ block.settings.value_prop_tag }}</span>
        {% endunless %}
        <span class="ac-checklist__value-text">{{ vp_text }}</span>
      </li>
    {% endif %}
  </ul>
</div>
